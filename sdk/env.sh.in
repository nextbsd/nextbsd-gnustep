# NextBSD GNUstep SDK (@T@): source this file to cross-compile GNUstep
# software for NextBSD @T@ in the nextbsd-toolchain container
# (ghcr.io/nextbsd/nextbsd-toolchain:@T@-latest), or another Linux host with
# clang and lld 19.
#
#   NEXTBSD_SDK=/opt/nextbsd-gnustep-sdk-@T@ . /opt/nextbsd-gnustep-sdk-@T@/env.sh
#   cd MyApp && make && make install DESTDIR=/tmp/stage
#
# Then:
#   - clang and clang++ are the SDK's (bin/nextbsd-cc): the image's clang for
#     @CLANG_TARGET@ with this SDK as the sysroot. GNUstep's makefiles record
#     native paths (/usr/include, /usr/lib/system, /usr/X11 ...); nextbsd-cc
#     points those into the SDK.
#   - gnustep-make is the SDK's: /System must be the SDK's System, because
#     GNUstep's makefiles and configure scripts use its absolute paths. This
#     script makes /System a link to it when the host has no /System (a Linux
#     build container never has one), and stops otherwise.
#   - pkg-config sees only the SDK's .pc files; autotools configure scripts get
#     the SDK's answers for checks that would run a NextBSD program
#     (CONFIG_SITE); give them --host=$NEXTBSD_HOST.
#   - Bundles and apps need the build host's plmerge and pl2link (Debian and
#     Ubuntu: apt-get install gnustep-base-runtime); the SDK's own tools are
#     NextBSD programs and never run on the build host.
#
# Environment it reads: NEXTBSD_SDK (required); NEXTBSD_CLANG_BINDIR (default
# $CROSS_BINDIR, then /usr/lib/llvm-19/bin).

if [ -z "${NEXTBSD_SDK:-}" ]; then
    echo "env.sh: set NEXTBSD_SDK to the SDK's directory first" >&2
    return 1 2>/dev/null || exit 1
fi
NEXTBSD_SDK=$(cd "$NEXTBSD_SDK" && pwd)
export NEXTBSD_SDK
export NEXTBSD_SYSROOT="$NEXTBSD_SDK"
export NEXTBSD_TARGET=@CLANG_TARGET@
export NEXTBSD_HOST=@GS_HOST@
export NEXTBSD_CLANG_BINDIR="${NEXTBSD_CLANG_BINDIR:-${CROSS_BINDIR:-/usr/lib/llvm-19/bin}}"

if [ -L /System ]; then
    if [ "$(readlink /System)" != "$NEXTBSD_SDK/System" ]; then
        echo "env.sh: /System links to $(readlink /System), not this SDK" >&2
        return 1 2>/dev/null || exit 1
    fi
elif [ -e /System ]; then
    echo "env.sh: this host has a /System of its own; use a build container" >&2
    return 1 2>/dev/null || exit 1
else
    ln -s "$NEXTBSD_SDK/System" /System || { return 1 2>/dev/null || exit 1; }
fi

export PATH="$NEXTBSD_SDK/bin:$PATH:/System/Library/Tools"
export CC=clang CXX=clang++ OBJC=clang
export GNUSTEP_MAKEFILES=/System/Library/Makefiles
export GNUSTEP_CONFIG_FILE=/System/Library/Preferences/GNUstep.conf
export PKG_CONFIG_LIBDIR="$NEXTBSD_SDK/usr/libdata/pkgconfig:$NEXTBSD_SDK/usr/X11/lib/pkgconfig"
export PKG_CONFIG_PATH=/System/Library/Libraries/pkgconfig
unset PKG_CONFIG_SYSROOT_DIR PKG_CONFIG
export CONFIG_SITE="$NEXTBSD_SDK/share/nextbsd-gnustep/nextbsd-@T@.site"
